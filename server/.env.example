# =================================================================
# FundBridge Backend Environment Variables (server/.env.example)
# =================================================================

# Server Port
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Allowed Frontend Origin for CORS (Use http://localhost:3000 in dev, production domain in prod)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/fundbridge?retryWrites=true&w=majority
# (If omitted, FundBridge uses in-memory data store with comprehensive seed data)
MONGODB_URI=

# JWT Secret Key for HMAC-SHA256 signing of authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Used for verifying Google ID tokens cryptographically
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe Payment Gateway Credentials (Stripe Dashboard -> Developers -> API Keys)
# STRIPE_SECRET_KEY: Used to create Checkout Sessions (begins with sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET: Used for verifying Stripe webhook signature (begins with whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# imgBB API Key for server-side image uploads (from https://api.imgbb.com/)
IMGBB_API_KEY=your_imgbb_api_key
