# =================================================================
# FundBridge Frontend Environment Variables (client/.env.example)
# =================================================================

# Backend Base API URL (defaults to /api for relative proxy)
VITE_API_URL=/api

# Stripe Public Publishable Key (Stripe Dashboard -> Developers -> API Keys)
# Safe for frontend exposure; starts with pk_test_... or pk_live_...
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key

# Google OAuth Client ID for Google Identity Services / GSI Sign-In Button
# Safe for frontend exposure; matches backend GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Firebase Client Configuration (Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id

# imgBB Public Upload Key (Optional fallback if direct client-side upload is used)
VITE_IMGBB_API_KEY=your_imgbb_api_key
